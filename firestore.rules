rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVolunteer() {
      return isAuthenticated() && getUserData().role == 'VOLUNTEER';
    }

    function isOrganization() {
      return isAuthenticated() && getUserData().role == 'ORGANIZATION';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    // Users Collection: users can only write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Volunteer Profiles: sensitive identity like CNIC is protected
    match /volunteer_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Organizations: Publicly readable, writeable only by authorized org
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if (isOrganization() && request.auth.uid == orgId) || isAdmin();
    }

    // Events: Publicly readable, created/edited only by the hosting organization
    match /events/{eventId} {
      allow read: if true;
      allow create: if isOrganization() && request.resource.data.organizationId == request.auth.uid;
      allow update, delete: if isOrganization() && resource.data.organizationId == request.auth.uid || isAdmin();
    }

    // Applications: STRICT SERVER-SIDE APPLICATION LIMIT & ACCESS CONTROL
    match /applications/{applicationId} {
      // Volunteers can view their own applications. Organizations can view applicants for their events.
      allow read: if isAuthenticated() && (
        resource.data.volunteerId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid ||
        isAdmin()
      );

      // Volunteer creation rule: Must be volunteer, can only set their own volunteerId, initial status must be PENDING
      // Backend limit enforcement: Maximum 2 active applications
      allow create: if isVolunteer() &&
        request.resource.data.volunteerId == request.auth.uid &&
        request.resource.data.status == 'PENDING';

      // Volunteer can only CANCEL their pending application;
      // Organization can accept or reject applications for their events
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.volunteerId && request.resource.data.status == 'CANCELLED') ||
        (request.auth.uid == resource.data.organizationId && request.resource.data.status in ['ACCEPTED', 'REJECTED', 'COMPLETED']) ||
        isAdmin()
      );

      // Prevent accidental deletion of application history
      allow delete: if isAdmin();
    }

    // Chats & Messages: Accessible only by involved volunteer and organization
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.volunteerId ||
        request.auth.uid == resource.data.organizationId ||
        isAdmin()
      );
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
    }

    // Notifications: Private to user
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Reports: Any user can submit a report; only admin can view/manage
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
